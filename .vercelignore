# Exclude local dependencies, build outputs and deployment cache
node_modules
dist
.vercel
.wrangler
.git

# Never upload local credentials or environment files
.env
.env.*
.dev.vars
.dev.vars.*
*.pem
*.key

# Local backups, reports, test artifacts and scratch files
backups
reports
test-results
playwright-report
tmp-vehicles
tmp-*
*.log
work.done

# Browser test harness is not needed for production build
tests
playwright.config.ts
